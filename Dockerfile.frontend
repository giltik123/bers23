FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_CORE_API_URL
ENV VITE_CORE_API_URL=$VITE_CORE_API_URL
RUN npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node config/frontendSecurityPolicy.mjs ./config/frontendSecurityPolicy.mjs
COPY --chown=node:node scripts/serve-v1-frontend.mjs ./scripts/serve-v1-frontend.mjs

USER node
EXPOSE 8080
CMD ["node", "scripts/serve-v1-frontend.mjs"]
