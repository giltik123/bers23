FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_CORE_API_URL=/api/core
ENV VITE_CORE_API_URL=${VITE_CORE_API_URL}
RUN npm run build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/config/frontendSecurityPolicy.mjs ./config/frontendSecurityPolicy.mjs
COPY --from=build --chown=node:node /app/scripts/serve-production-frontend.mjs ./scripts/serve-production-frontend.mjs
COPY --from=build --chown=node:node /app/scripts/production-core-api-proxy.mjs ./scripts/production-core-api-proxy.mjs
USER node
EXPOSE 8080
CMD ["node", "scripts/serve-production-frontend.mjs"]
