{
  "name": "AutomationRun",
  "type": "object",
  "properties": {
    "automation_id": {
      "type": "string"
    },
    "automation_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "completed",
        "failed",
        "skipped"
      ],
      "default": "queued"
    },
    "estimated_credits": {
      "type": "number",
      "default": 0
    },
    "credits_consumed": {
      "type": "number",
      "default": 0
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    },
    "action_count": {
      "type": "number",
      "default": 0
    },
    "result": {
      "type": "object",
      "additionalProperties": true
    },
    "error": {
      "type": "string"
    },
    "executed_at": {
      "type": "string"
    }
  },
  "required": [
    "automation_id",
    "automation_name",
    "status"
  ]
}