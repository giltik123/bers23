{
  "name": "CreditTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "grant",
        "reserve",
        "release",
        "spend",
        "refund"
      ]
    },
    "credit_type": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "completed"
    },
    "project_id": {
      "type": "string"
    },
    "reservation_id": {
      "type": "string"
    },
    "breakdown": {
      "type": "object",
      "additionalProperties": true
    },
    "reason": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "amount"
  ]
}