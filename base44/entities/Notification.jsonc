{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "info"
      ],
      "default": "info"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "job_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "title",
    "message"
  ]
}