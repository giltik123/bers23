{
  "name": "Automation",
  "type": "object",
  "properties": {
    "automation_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "estimated_credits": {
      "type": "number",
      "default": 0
    },
    "estimated_time": {
      "type": "number",
      "default": 0
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "schedule": {
      "type": "string",
      "enum": [
        "immediate",
        "scheduled",
        "daily",
        "weekly",
        "manual_only"
      ],
      "default": "manual_only"
    },
    "scheduled_for": {
      "type": "string"
    },
    "favorite": {
      "type": "boolean",
      "default": false
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "automation_id",
    "name",
    "trigger"
  ]
}