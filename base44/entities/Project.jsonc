{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "original_image_url": {
      "type": "string"
    },
    "current_image_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "width": {
      "type": "number"
    },
    "height": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "editing",
        "processing",
        "completed"
      ],
      "default": "draft"
    },
    "favorite": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image_url": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    },
    "history_index": {
      "type": "number",
      "default": -1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "mask_url": {
            "type": "string"
          },
          "box": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            }
          },
          "editable": {
            "type": "boolean",
            "default": true
          },
          "selected": {
            "type": "boolean",
            "default": false
          },
          "confidence": {
            "type": "number"
          },
          "parent_object": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object_id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "preview_image_url": {
            "type": "string"
          },
          "result_image_url": {
            "type": "string"
          },
          "credits_used": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "failed"
            ]
          }
        }
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "preview_url": {
            "type": "string"
          },
          "operations_included": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "name",
    "original_image_url"
  ]
}