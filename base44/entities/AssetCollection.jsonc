{
  "name": "AssetCollection",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "folder",
        "pinned",
        "smart"
      ],
      "default": "folder"
    },
    "query": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ]
}