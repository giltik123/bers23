      "type": "number",
      "default": 0
    },
    "storage_used": {
      "type": "number",
      "default": 0
    },
    "ai_generations": {
      "type": "number",
      "default": 0
    },
    "tryon_generations": {
      "type": "number",
      "default": 0
    },
    "recipe_usage": {
      "type": "number",
      "default": 0
    },
    "daily_usage": {
      "type": "object",
      "additionalProperties": true
    },
    "monthly_usage": {
      "type": "object",
      "additionalProperties": true
    },
    "feature_usage": {
      "type": "object",
      "additionalProperties": true
    }
