{
  "name": "Garment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "preview_url": {
      "type": "string"
    },
    "original_image_url": {
      "type": "string"
    },
    "mask_url": {
      "type": "string"
    },
    "dominant_color": {
      "type": "string"
    },
    "secondary_colors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material": {
      "type": "string"
    },
    "pattern": {
      "type": "string"
    },
    "texture": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "gender": {
      "type": "string"
    },
    "fit": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "favorite": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "source": {
      "type": "string",
      "enum": [
        "personal",
        "imported",
        "online"
      ],
      "default": "personal"
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "name",
    "category"
  ]
}